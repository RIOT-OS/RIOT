USEMODULE += core_thread_flags
USEMODULE += random
USEMODULE += iolist
USEMODULE += mcux_xcvr_mkw41z
ifneq (,$(filter netdev,$(USEMODULE)))
  USEMODULE += netdev_ieee802154_submac
  DEFAULT_MODULE += netdev_ieee802154_oqpsk
endif

ifneq (,$(filter ieee802154_submac,$(USEMODULE)))
  USEMODULE += ieee802154_submac_soft_csma_ca
  USEMODULE += ieee802154_submac_soft_frame_retrans
endif

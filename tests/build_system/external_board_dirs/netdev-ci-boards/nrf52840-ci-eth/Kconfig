config BOARD
    default "nrf52840-ci-eth" if BOARD_NRF52840DK_CI_ETH

config BOARD_NRF52840DK_CI_ETH
    bool
    default y
    select BOARDS_COMMON_NRF52XXXDK
    select CPU_MODEL_NRF52840XXAA

source "$(RIOTBOARD)/common/nrf52xxxdk/Kconfig"

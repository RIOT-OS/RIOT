config BOARD
    default "esp32s2-ci" if BOARD_ESP32S2_CI

config BOARD_ESP32S2_CI
    bool
    default y
    select BOARD_COMMON_ESP32S2
    select CPU_MODEL_ESP32S2_MINI_1X_N4R2

source "$(RIOTBOARD)/common/esp32s2/Kconfig"

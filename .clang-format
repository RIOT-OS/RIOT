# SPDX-License-Identifier: GPL-2.0
#
# clang-format configuration file. Intended for clang-format >= 18.
#
# For more information, see:
#
#   https://clang.llvm.org/docs/ClangFormat.html
#   https://clang.llvm.org/docs/ClangFormatStyleOptions.html
#
# Based on the Linux kernel config, e.g. see
# https://github.com/torvalds/linux/blob/1d227fcc72223cbdd34d0ce13541cbaab5e0d72f/.clang-format
---
AccessModifierOffset: -4
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignConsecutiveMacros: AcrossEmptyLinesAndComments
# escaped newlines are not aligned (a `\` directly follows the expression)
AlignEscapedNewlines: DontAlign
AlignOperands: true
AlignTrailingComments: true
AllowAllParametersOfDeclarationOnNextLine: false
# "Indentation and braces": empty `{}` braces stay on the same line
# (e.g. `while (HW_STATUS != STATUS_OK) {}`), non-empty blocks are never
# merged
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
# "Indentation and braces": braces are added to single-statement bodies of
# if/else/for/while/do by InsertBraces below, so this only affects empty
# statements (`while (x);`) and one-line blocks that already have braces
AllowShortLoopsOnASingleLine: true
AlwaysBreakAfterDefinitionReturnType: None
AlwaysBreakAfterReturnType: None
AlwaysBreakBeforeMultilineStrings: false
AlwaysBreakTemplateDeclarations: false
BinPackArguments: true
BinPackParameters: true
# "Bit fields": space before and after the colon (e.g. `uint8_t a : 1`)
BitFieldColonSpacing: Both
BraceWrapping:
  AfterClass: false
  AfterControlStatement: false
  AfterEnum: false
  AfterFunction: true
  AfterNamespace: true
  AfterObjCDeclaration: false
  AfterStruct: false
  AfterUnion: false
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: true
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
BreakBeforeBinaryOperators: None
BreakBeforeBraces: Custom
BreakBeforeInheritanceComma: false
BreakBeforeTernaryOperators: false
BreakConstructorInitializersBeforeComma: false
BreakConstructorInitializers: BeforeComma
BreakAfterJavaFieldAnnotations: false
# adjacent string literals can only be wrapped between literals; keep this
# enabled so concatenations are split at the 100 character limit instead of
# overflowing it (disabling it can produce lines longer than the limit)
BreakAdjacentStringLiterals: true
BreakStringLiterals: false
# "Line length": the coding conventions aim for 80 characters per line with an
# absolute maximum of 100. clang-format can only enforce the hard maximum, so
# set the limit to 100 and leave lines up to 100 characters untouched (the
# 80 character target is a soft guideline for humans, not the formatter)
ColumnLimit: 100
CommentPragmas: '^ IWYU pragma:'
CompactNamespaces: false
ConstructorInitializerAllOnOneLineOrOnePerLine: false
ConstructorInitializerIndentWidth: 4
ContinuationIndentWidth: 4
Cpp11BracedListStyle: false
DerivePointerAlignment: false
DisableFormat: false
ExperimentalAutoDetectBinPacking: false
FixNamespaceComments: false

IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<.*>$'
    Priority: 1
  - Regex: '^".*"'
    Priority: 2
IncludeIsMainRegex: '^$'
IndentCaseLabels: false
IndentGotoLabels: false
IndentPPDirectives: AfterHash
PPIndentWidth: 2
IndentWidth: 4
IndentWrappedFunctionNames: false
# "Indentation and braces": always use curly braces, even for one-line
# blocks
InsertBraces: true
# all files end with exactly one newline
InsertNewlineAtEOF: true
JavaScriptQuotes: Leave
JavaScriptWrapImports: true
KeepEmptyLinesAtTheStartOfBlocks: false
# "Line endings": all line endings shall be LF
LineEnding: LF
MacroBlockBegin: ''
MacroBlockEnd: ''
MaxEmptyLinesToKeep: 1
NamespaceIndentation: None

# Adapted from git's rules
PenaltyBreakAssignment: 100
PenaltyBreakBeforeFirstCallParameter: 100
PenaltyBreakComment: 10
PenaltyBreakFirstLessLess: 0
PenaltyBreakString: 10
# penalty for exceeding the column limit; a low value lets clang-format
# overflow ColumnLimit instead of wrapping, so keep it high enough that the
# 100 character hard maximum is actually enforced (lines up to 100 characters
# are left untouched)
PenaltyExcessCharacter: 100
PenaltyReturnTypeOnItsOwnLine: 60

PointerAlignment: Right
# re-wrap/indent comments so that multi-line trailing comments (e.g. enum
# members with `/**< ... */`) stay aligned when the code next to them is
# re-formatted; clang-format still does not add leading `*` or fix `*/`
ReflowComments: true
# remove superfluous semicolons (e.g. after an empty brace block)
RemoveSemicolon: true
# do not format macro definition bodies: clang-format would expand brace
# initializer macros (e.g. `#define FOO { 1, 2 }`) into multi-line backslash
# continuations and would also split `do { ... } while (0)` bodies, which
# destroys the intended one-line form
SkipMacroDefinitionBody: true
SortIncludes: true
SortUsingDeclarations: false
SpaceAfterCStyleCast: false
SpaceAfterTemplateKeyword: true
SpaceBeforeAssignmentOperators: true
# This results in consistently having no space after a
# type cast, even when a braced initializer list comes
SpaceBeforeCpp11BracedList: false
SpaceBeforeCtorInitializerColon: true
SpaceBeforeInheritanceColon: true
SpaceBeforeParens: ControlStatementsExceptForEachMacros
SpaceBeforeRangeBasedForLoopColon: true
SpaceInEmptyParentheses: false
SpacesBeforeTrailingComments: 1
SpacesInAngles: false
SpacesInContainerLiterals: false
SpacesInCStyleCastParentheses: false
SpacesInParentheses: false
SpacesInSquareBrackets: false
Standard: Cpp03
TabWidth: 4
UseTab: Never

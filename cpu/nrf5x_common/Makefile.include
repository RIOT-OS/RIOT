CFLAGS += -DCPU_FAM_$(call uppercase_and_underscore,$(CPU_FAM))

ROM_START_ADDR ?= 0x00000000
RAM_START_ADDR ?= 0x20000000

LINKER_SCRIPT ?= cortexm.ld

INCLUDES += -I$(RIOTCPU)/nrf5x_common/include
INCLUDES += -I$(BINDIR)/pkg-build/nrfx

# Only explicitly fetch vendor headers standalone if nrfx is not already pulled
# in as a full package. The vendor headers are always required and will be
# copied to the $(PKG_BUILD_DIR) folder in both cases.
ifeq (,$(filter nrfx,$(USEPKG)))
fetch_nrfx_vendor_headers: FORCE $(CLEAN)
	$(Q)+$(MAKE) -C $(RIOTPKG)/nrfx

BUILDDEPS += fetch_nrfx_vendor_headers
endif

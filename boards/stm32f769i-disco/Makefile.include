# we use shared STM32 configuration snippets
INCLUDES += -I$(RIOTBOARD)/common/stm32/include

# this board uses openocd with st-link
PROGRAMMER ?= openocd

# this board has an on-board ST-link adapter
OPENOCD_DEBUG_ADAPTER ?= stlink

# connect under reset, so the board can be flashed even if the running
# firmware has disabled the debug port or entered in a low-power mode
OPENOCD_RESET_USE_CONNECT_ASSERT_SRST ?= 1

# openocd programmer is supported
PROGRAMMERS_SUPPORTED += openocd

# heap configuration
FMC_RAM_ADDR=0xc0000000
FMC_RAM_LEN=16384K

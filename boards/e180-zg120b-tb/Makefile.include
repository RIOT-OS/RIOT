# setup JLink for flashing
JLINK_DEVICE = EFR32MG1BxxxF256
JLINK_PRE_FLASH += r

# setup OpenOCD for flashing
OPENOCD_DEBUG_ADAPTER ?= stlink

# default to JLink as programmer if available
JLINK ?= JLinkExe

ifneq (,$(shell command -v $(JLINK) 2>/dev/null))
  PROGRAMMER ?= jlink
else
  PROGRAMMER ?= openocd
endif

# board can also use BMP or OpenOCD as programmer
PROGRAMMERS_SUPPORTED += bmp openocd

# Process provided FEATURES
#
# The board/board common are responsible for defining the CPU and CPU_MODEL
# variables in their Makefile.features.
# This makes them available when setting features based on CPU_MODEL in the cpu
# Makefile.features and also during dependency resolution.
#
# Board features defined by common code in `boards/common` are processed
# during the dependency resolution, since they depend on the USEMODULE.

# Transition:
#   Moving 'CPU/CPU_MODEL' to Makefile.features is an ongoing work and may not
#   reflect the state of all boards for the moment.

include $(BOARDDIR)/Makefile.features

# Sanity check
ifeq (,$(CPU))
  $(error $(BOARD): CPU must be defined by board / board_common Makefile.features)
endif

# Resolve nested CPU family paths, e.g. cpu/sam0/samd21 or cpu/sam/sam4s.
CPU_DIR := $(strip $(CPU_DIR))
ifeq ($(CPU_DIR),)
  CPU_DIR := $(CPU)
endif
ifneq ($(wildcard $(RIOTCPU)/$(CPU)/Makefile.features),)
  CPU_DIR := $(CPU)
else
  _cpu_dir_candidates := $(wildcard $(RIOTCPU)/*/$(CPU)/Makefile.features)
  ifneq ($(_cpu_dir_candidates),)
    CPU_DIR := $(patsubst %/Makefile.features,%,$(patsubst $(RIOTCPU)/%,%,$(firstword $(_cpu_dir_candidates))))
  endif
endif
export CPU_DIR

include $(RIOTCPU)/$(CPU_DIR)/Makefile.features

# Provide CPU as a feature to allow listing all boards with a CPU
FEATURES_PROVIDED += cpu_$(CPU)

# Features that are conflicting for all architectures
FEATURES_CONFLICT += picolibc:newlib
FEATURES_CONFLICT_MSG += "Only one standard C library can be used."

# The libstdc++/libsupc++ shipped with the GCC toolchains and used by LLVM
# is built against newlib and these include newlib C headers that conflict
# with picolibc.
# Special care is needed for picolibc and libstdc++ to work: In addition to
# the default libstdc++ compiled against newlib, a second one compiled against
# picolibc needs to be installed and the `picolibc.specs` file needs to adjust
# the builtin search paths for libs and headers so that the correct libstdc++ is
# found.
#
# Notably, Debian and Ubuntu users can install e.g. libstdc++-arm-none-eabi-picolibc
# in addition to the `arm-none-eabi` toolchain and should be good. They can safely
# override the check with `export PICOLIBC_CPP_OVERRIDE=1`. Other toolchains
# may not include a compatible libstdc++, causing cryptic compilation errors.
#
# Strictly speaking, C++ code not making use of libstdc++ should still be possible.
# In practice, including basic C++ headers will cause compilation issue due to
# libstdc++ headers depending on internal implementation details of newlib / picolibc.
# Hence, even basic C++ is marked as incompatible with picolibc by default.
ifneq (1,$(PICOLIBC_CPP_OVERRIDE))
  FEATURES_CONFLICT += cpp:picolibc
  FEATURES_CONFLICT += libstdcpp:picolibc
  FEATURES_CONFLICT_MSG += "picolibc can not be used with C++, you can override this by setting PICOLIBC_CPP_OVERRIDE=1."
endif

FEATURES_CONFLICT += periph_gpio_irq:periph_gpio_ll_irq
FEATURES_CONFLICT_MSG += "Only one GPIO IRQ implementation can be used."

FEATURES_CONFLICT += periph_usbdev:tinyusb_device
FEATURES_CONFLICT += periph_usbdev:tinyusb_host
FEATURES_CONFLICT_MSG += "Package tinyUSB is not yet compatible with periph_usbdev."

# Features provided implicitly
ifneq (,$(filter periph_eth,$(FEATURES_PROVIDED)))
  FEATURES_PROVIDED += netif_ethernet
endif

ifneq (,$(filter netif_%,$(FEATURES_PROVIDED)))
  FEATURES_PROVIDED += netif
endif

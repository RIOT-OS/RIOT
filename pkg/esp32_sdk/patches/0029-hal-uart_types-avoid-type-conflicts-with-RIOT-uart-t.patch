From 0be2e6bf058c7cfef1bd58a872b089cff8b1d084 Mon Sep 17 00:00:00 2001
From: Gunar Schorcht <gunar@schorcht.net>
Date: Tue, 25 Mar 2025 14:12:40 +0100
Subject: [PATCH 29/51] hal/uart_types: avoid type conflicts with RIOT uart
 types

---
 components/esp_hal_uart/include/hal/uart_types.h | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/components/esp_hal_uart/include/hal/uart_types.h b/components/esp_hal_uart/include/hal/uart_types.h
index 953d1ab04e..69fb20d43b 100644
--- a/components/esp_hal_uart/include/hal/uart_types.h
+++ b/components/esp_hal_uart/include/hal/uart_types.h
@@ -61,6 +61,7 @@ typedef enum {
     UART_DATA_BITS_MAX = 0x4,
 } uart_word_length_t;
 
+#ifndef HAVE_UART_STOP_BITS_T
 /**
  * @brief UART stop bits number
  */
@@ -70,7 +71,9 @@ typedef enum {
     UART_STOP_BITS_2   = 0x3,  /*!< stop bit: 2bits*/
     UART_STOP_BITS_MAX = 0x4,
 } uart_stop_bits_t;
+#endif
 
+#ifndef HAVE_UART_PARITY_T
 /**
  * @brief UART parity constants
  */
@@ -79,6 +82,7 @@ typedef enum {
     UART_PARITY_EVEN     = 0x2,  /*!< Enable UART even parity*/
     UART_PARITY_ODD      = 0x3   /*!< Enable UART odd parity*/
 } uart_parity_t;
+#endif
 
 /**
  * @brief UART hardware flow control modes

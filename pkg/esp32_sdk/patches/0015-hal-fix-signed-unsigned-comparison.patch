From 163af5643ba21d6ccdb3d541eee5b45270f89a2d Mon Sep 17 00:00:00 2001
From: Gunar Schorcht <gunar@schorcht.net>
Date: Sat, 1 Mar 2025 18:03:20 +0100
Subject: [PATCH 15/51] hal: fix signed/unsigned comparison

---
 components/esp_hal_mspi/esp32c3/include/hal/gpspi_flash_ll.h  | 2 +-
 components/esp_hal_mspi/esp32c3/include/hal/spimem_flash_ll.h | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/components/esp_hal_mspi/esp32c3/include/hal/gpspi_flash_ll.h b/components/esp_hal_mspi/esp32c3/include/hal/gpspi_flash_ll.h
index 417848a0dc..4ea55535d3 100644
--- a/components/esp_hal_mspi/esp32c3/include/hal/gpspi_flash_ll.h
+++ b/components/esp_hal_mspi/esp32c3/include/hal/gpspi_flash_ll.h
@@ -81,7 +81,7 @@ static inline void gpspi_flash_ll_get_buffer_data(spi_dev_t *dev, void *buffer,
     } else {
         // Otherwise, slow(er) path copies word by word
         int copy_len = read_len;
-        for (int i = 0; i < (read_len + 3) / 4; i++) {
+        for (uint32_t i = 0; i < (read_len + 3) / 4; i++) {
             int word_len = MIN(sizeof(uint32_t), copy_len);
             uint32_t word = dev->data_buf[i];
             memcpy(buffer, &word, word_len);
diff --git a/components/esp_hal_mspi/esp32c3/include/hal/spimem_flash_ll.h b/components/esp_hal_mspi/esp32c3/include/hal/spimem_flash_ll.h
index 85536ec8e8..d96f790079 100644
--- a/components/esp_hal_mspi/esp32c3/include/hal/spimem_flash_ll.h
+++ b/components/esp_hal_mspi/esp32c3/include/hal/spimem_flash_ll.h
@@ -353,7 +353,7 @@ static inline void spimem_flash_ll_get_buffer_data(spi_mem_dev_t *dev, void *buf
     } else {
         // Otherwise, slow(er) path copies word by word
         int copy_len = read_len;
-        for (int i = 0; i < (read_len + 3) / 4; i++) {
+        for (uint32_t i = 0; i < (read_len + 3) / 4; i++) {
             int word_len = MIN(sizeof(uint32_t), copy_len);
             uint32_t word = dev->data_buf[i];
             memcpy(buffer, &word, word_len);
-- 
2.43.0


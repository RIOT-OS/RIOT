From 732d8ab0ded2d772f87fc0a11c6454842adcdc92 Mon Sep 17 00:00:00 2001
From: Gunar Schorcht <gunar@schorcht.net>
Date: Mon, 31 Mar 2025 09:07:03 +0200
Subject: [PATCH 31/51] hal/esp32h2/gspi_flash_ll: fix signed/unsigned
 comparison

---
 components/esp_hal_mspi/esp32h2/include/hal/gpspi_flash_ll.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/components/esp_hal_mspi/esp32h2/include/hal/gpspi_flash_ll.h b/components/esp_hal_mspi/esp32h2/include/hal/gpspi_flash_ll.h
index 07b9a1ab02..7c5d1197bf 100644
--- a/components/esp_hal_mspi/esp32h2/include/hal/gpspi_flash_ll.h
+++ b/components/esp_hal_mspi/esp32h2/include/hal/gpspi_flash_ll.h
@@ -82,7 +82,7 @@ static inline void gpspi_flash_ll_get_buffer_data(spi_dev_t *dev, void *buffer,
     } else {
         // Otherwise, slow(er) path copies word by word
         int copy_len = read_len;
-        for (int i = 0; i < (read_len + 3) / 4; i++) {
+        for (uint32_t i = 0; i < (read_len + 3) / 4; i++) {
             int word_len = MIN(sizeof(uint32_t), copy_len);
             uint32_t word = dev->data_buf[i].buf0;
             memcpy(buffer, &word, word_len);
-- 

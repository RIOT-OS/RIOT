From 42be67930029615672c875f85b19fb9862897d99 Mon Sep 17 00:00:00 2001
From: Gunar Schorcht <gunar@schorcht.net>
Date: Mon, 21 Apr 2025 00:07:42 +0200
Subject: [PATCH 36/51] hal/esp32c6/gspi_flash_ll: fix signed/unsigned
 comparison

---
 components/esp_hal_mspi/esp32c6/include/hal/gpspi_flash_ll.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/components/esp_hal_mspi/esp32c6/include/hal/gpspi_flash_ll.h b/components/esp_hal_mspi/esp32c6/include/hal/gpspi_flash_ll.h
index f9bff2ade2..a96a0ed6f5 100644
--- a/components/esp_hal_mspi/esp32c6/include/hal/gpspi_flash_ll.h
+++ b/components/esp_hal_mspi/esp32c6/include/hal/gpspi_flash_ll.h
@@ -82,7 +82,7 @@ static inline void gpspi_flash_ll_get_buffer_data(spi_dev_t *dev, void *buffer,
     } else {
         // Otherwise, slow(er) path copies word by word
         int copy_len = read_len;
-        for (int i = 0; i < (read_len + 3) / 4; i++) {
+        for (unsigned i = 0; i < (read_len + 3) / 4; i++) {
             int word_len = MIN(sizeof(uint32_t), copy_len);
             uint32_t word = dev->data_buf[i].buf;
             memcpy(buffer, &word, word_len);
-- 

From 8abc3a71e5b1a7988fab8ce58addbee2a26278f4 Mon Sep 17 00:00:00 2001
From: Gunar Schorcht <gunar@schorcht.net>
Date: Mon, 21 Apr 2025 00:08:06 +0200
Subject: [PATCH 37/51] hal/esp32c6/spimem_flash_ll: fix signed/unsigned
 comparison

---
 components/esp_hal_mspi/esp32c6/include/hal/spimem_flash_ll.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/components/esp_hal_mspi/esp32c6/include/hal/spimem_flash_ll.h b/components/esp_hal_mspi/esp32c6/include/hal/spimem_flash_ll.h
index 22e76f0847..2389b4e05e 100644
--- a/components/esp_hal_mspi/esp32c6/include/hal/spimem_flash_ll.h
+++ b/components/esp_hal_mspi/esp32c6/include/hal/spimem_flash_ll.h
@@ -354,7 +354,7 @@ static inline void spimem_flash_ll_get_buffer_data(spi_mem_dev_t *dev, void *buf
     } else {
         // Otherwise, slow(er) path copies word by word
         int copy_len = read_len;
-        for (int i = 0; i < (read_len + 3) / 4; i++) {
+        for (unsigned i = 0; i < (read_len + 3) / 4; i++) {
             int word_len = MIN(sizeof(uint32_t), copy_len);
             uint32_t word = dev->data_buf[i];
             memcpy(buffer, &word, word_len);
-- 

From f481cdeb91f764ca953e0b7d9f7ea51861aa09d7 Mon Sep 17 00:00:00 2001
From: Simon Grund <mail@simongrund.de>
Date: Wed, 26 Aug 2026 14:53:53 +0200
Subject: [PATCH 5/9] Remove Unnecessary WaitQueue

These are unused especially with the custom storage backend
---
 bpa/stor/inc/bplib_stor.h | 5 ++---
 ci/qm/src/bplib_qm.c      | 6 +++---
 inc/bplib_inst.h          | 2 +-
 3 files changed, 6 insertions(+), 7 deletions(-)

diff --git a/bpa/stor/inc/bplib_stor.h b/bpa/stor/inc/bplib_stor.h
index 93a39c3c..ef8736f1 100644
--- a/bpa/stor/inc/bplib_stor.h
+++ b/bpa/stor/inc/bplib_stor.h
@@ -76,11 +76,10 @@ struct BPLib_BundleCache
 {
     mutex_t lock;
     int64_t                BundleRowsToDelete[BPLIB_STOR_DISCARDBATCHSIZE];
-    BPLib_Bundle_t*        InsertBatch[BPLIB_STOR_INSERTBATCHSIZE];
-    size_t                 InsertBatchSize;
     /* The load batches are removed for RIOT because they are very implementation dependent.
      * Loading the numbers (which iirc were the row numbers in the blob table) does not really
-     * help if the actual storage implementation uses some other indexing / storage medium. */
+     * help if the actual storage implementation uses some other indexing / storage medium.
+     * The same goes for the insert batches */
     BPLib_STOR_CtUpdateBatch_t CustodyUpdateBatch;
     int64_t                LastActiveTime;
     size_t                 BundleCountNotEgressed;  /* Number of bundles in storage that have not been marked as egressed */
diff --git a/ci/qm/src/bplib_qm.c b/ci/qm/src/bplib_qm.c
index 8cc9f531..c079ccdb 100644
--- a/ci/qm/src/bplib_qm.c
+++ b/ci/qm/src/bplib_qm.c
@@ -61,10 +61,10 @@ BPLib_Status_t BPLib_QM_QueueTableInit(BPLib_Instance_t* inst, size_t MaxJobs)
 
     QueueInit = true;
 
-    if (!BPLib_QM_WaitQueueInit(&(inst->BundleCacheList), sizeof(BPLib_Bundle_t*), MaxJobs))
+    /*if (!BPLib_QM_WaitQueueInit(&(inst->BundleCacheList), sizeof(BPLib_Bundle_t*), MaxJobs))
     {
         QueueInit = false;
-    }
+    }*/
 
     for (i = 0; i < BPLIB_QM_NUM_PRIORITIES; i++)
     {
@@ -112,7 +112,7 @@ void BPLib_QM_QueueTableDestroy(BPLib_Instance_t* inst)
     inst->NumWorkers = 0;
 
     /* Queue Cleanup */
-    BPLib_QM_WaitQueueDestroy(&(inst->BundleCacheList));
+    /*BPLib_QM_WaitQueueDestroy(&(inst->BundleCacheList));*/
 
     for (i = 0; i < BPLIB_QM_NUM_PRIORITIES; i++)
     {
diff --git a/inc/bplib_inst.h b/inc/bplib_inst.h
index ca220120..55965327 100644
--- a/inc/bplib_inst.h
+++ b/inc/bplib_inst.h
@@ -55,7 +55,7 @@ struct BPLib_Instance
 
     /* Queues */
     BPLib_QM_WaitQueue_t GenericWorkerJobs[BPLIB_QM_NUM_PRIORITIES]; /**< Queue of jobs */
-    BPLib_QM_WaitQueue_t BundleCacheList; /**< Queue of bundles in cache */
+    /*BPLib_QM_WaitQueue_t BundleCacheList; *//**< Queue of bundles in cache */
     BPLib_QM_WaitQueue_t ContactEgressJobs[BPLIB_MAX_NUM_CONTACTS]; /**< Queue of contact egress jobs */
     BPLib_QM_WaitQueue_t ChannelEgressJobs[BPLIB_MAX_NUM_CHANNELS]; /**< Queue of channel egress jobs */
 

USEMODULE += lvgl
USEMODULE += lvgl_core

ifneq (,$(filter lvgl_widget_animimage lvgl_widget_canvas,$(USEMODULE)))
  USEMODULE += lvgl_widget_image
endif

ifneq (,$(filter lvgl_widget_spinner,$(USEMODULE)))
  USEMODULE += lvgl_widget_arc
endif

ifneq (,$(filter lvgl_widget_slider,$(USEMODULE)))
  USEMODULE += lvgl_widget_bar
endif

ifneq (,$(filter lvgl_widget_scale,$(USEMODULE)))
  USEMODULE += lvgl_widget_image
  USEMODULE += lvgl_widget_line
endif

ifneq (,$(filter lvgl_widget_calendar lvgl_widget_list lvgl_widget_menu lvgl_widget_msgbox \
                 lvgl_widget_tabview lvgl_widget_win,$(USEMODULE)))
  USEMODULE += lvgl_layout_flex
endif

ifneq (,$(filter lvgl_widget_spinbox,$(USEMODULE)))
  USEMODULE += lvgl_widget_textarea
endif

ifneq (,$(filter lvgl_widget_keyboard,$(USEMODULE)))
  USEMODULE += lvgl_widget_buttonmatrix
  USEMODULE += lvgl_widget_textarea
endif

ifneq (,$(filter lvgl_widget_calendar,$(USEMODULE)))
  USEMODULE += lvgl_widget_button
  USEMODULE += lvgl_widget_buttonmatrix
  USEMODULE += lvgl_widget_dropdown
endif

ifneq (,$(filter lvgl_widget_list lvgl_widget_menu lvgl_widget_msgbox lvgl_widget_win,$(USEMODULE)))
  USEMODULE += lvgl_widget_image
endif

ifneq (,$(filter lvgl_widget_menu lvgl_widget_tabview lvgl_widget_win,$(USEMODULE)))
  USEMODULE += lvgl_widget_button
endif

ifneq (,$(filter lvgl_widget_dropdown lvgl_widget_list lvgl_widget_menu lvgl_widget_msgbox \
                 lvgl_widget_roller lvgl_widget_table lvgl_widget_tabview lvgl_widget_textarea \
                 lvgl_widget_win,$(USEMODULE)))
  USEMODULE += lvgl_widget_label
endif

ifneq (,$(filter lvgl_theme_default_dark lvgl_theme_default_grow,$(USEMODULE)))
  USEMODULE += lvgl_theme_default
endif

ifneq (,$(filter lvgl_sdl,$(USEMODULE)))
  FEATURES_REQUIRED += arch_native
endif

ifneq (,$(filter lvgl_contrib,$(USEMODULE)))
  USEMODULE += disp_dev
  USEMODULE += core_thread_flags
  USEMODULE += ztimer
  USEMODULE += ztimer_msec
endif

ifneq (,$(filter lvgl_contrib_touch,$(USEMODULE)))
  USEMODULE += touch_dev
endif

# lvgl is not compatible with non 32bit platforms
# Building lv_misc triggers the error:
# "left shift count >= width of type [-Werror=shift-count-overflow]"
FEATURES_BLACKLIST += arch_8bit
FEATURES_BLACKLIST += arch_16bit

+++ b/ud3tn_platform_riot/Makefile
@@ -0,0 +1,37 @@
+# name of your application
+APPLICATION = ud3tn-riot
+
+# If no BOARD is found in the environment, use this default:
+BOARD ?= native
+
+# This has to be the absolute path to the RIOT base directory:
+RIOTBASE ?= $(CURDIR)/../../../..
+
+include $(CURDIR)/Modules.include
+
+CFLAGS += -I$(CURDIR)/include
+CFLAGS += -DISR_STACKSIZE=2048
+CFLAGS += -DCONFIG_GNRC_TCP_RCV_BUFFERS=8 #sock_tcp_t listen_queue_array[4]; hängt von größe des Empfangspuffers ab
+# gnrc_tcp_close() blocks for 2*MSL (TIME_WAIT); default 30 s holds the TCB for 60 s
+CFLAGS += -DCONFIG_GNRC_TCP_MSL_MS=2000
+
+ifeq ($(BOARD),esp32-wroom-32)
+  CFLAGS += -DESP_WIFI_SSID=\"\"
+  CFLAGS += -DESP_WIFI_PASS=\"\"
+USEMODULE += esp_wifi
+endif
+
+WERROR=0
+WFORMAT=1
+
+# Comment this out to disable code in RIOT that does safety checking
+# which is not needed in a production environment but helps in the
+# development process:
+DEVELHELP ?= 1
+ENABLE_DEBUG = 1
+
+
+# Change this to 0 show compiler invocation lines by default:
+QUIET ?= 1
+
+include $(RIOTBASE)/Makefile.include

diff --git a/ud3tn_platform_riot/components/platform/riot/hal_semaphore.c b/ud3tn_platform_riot/components/platform/riot/hal_semaphore.c
new file mode 100644
index 0000000..40b54c5
--- /dev/null
+++ b/ud3tn_platform_riot/components/platform/riot/hal_semaphore.c
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: BSD-3-Clause OR Apache-2.0
+/*
+ * hal_semaphore.c
+ *
+ * Description: contains the RIOT implementation of the hardware
+ * abstraction layer interface for semaphore functionality
+ *
+ */
+
+#include "ud3tn/result.h"
+#include "platform/hal_semaphore.h"
+#include "platform/hal_types.h"
+
+#include <stdbool.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include "sema.h"
+#include "ztimer.h"
+
+void hal_semaphore_init_inplace(Semaphore_t sem, int value)
+{
+    sema_create(&sem->sem, value);
+}
+
+void hal_semaphore_take_blocking(Semaphore_t sem)
+{
+    sema_wait(&sem->sem);
+}
+
+void hal_semaphore_release(Semaphore_t sem)
+{
+    sema_post(&sem->sem);
+}
+
+bool hal_semaphore_is_blocked(Semaphore_t sem)
+{
+    /* Try to wait without blocking */
+    if (sema_try_wait(&sem->sem) == 0) {
+        sema_post(&sem->sem); // Restore if it succeeded
+        return false;
+    }
+    return true;
+}
+
+void hal_semaphore_delete(Semaphore_t sem)
+{
+    sema_destroy(&sem->sem);
+    free(sem);
+}
+
+enum ud3tn_result hal_semaphore_try_take(Semaphore_t sem, int64_t timeout_ms)
+{
+    if (timeout_ms < 0) {
+        hal_semaphore_take_blocking(sem);
+        return UD3TN_OK;
+    }
+    else if (timeout_ms == 0) {
+        return sema_try_wait(&sem->sem) == 0 ? UD3TN_OK : UD3TN_FAIL;
+    }
+    else {
+        int res = sema_wait_timed_ztimer(&sem->sem, ZTIMER_MSEC, timeout_ms);
+        if (res == 0) {
+            return UD3TN_OK;
+        }
+        return UD3TN_FAIL;
+    }
+}
+
+Semaphore_t hal_semaphore_init(void)
+{
+    Semaphore_t sem = malloc(sizeof(struct Semaphore));
+
+    if (sem) {
+        hal_semaphore_init_inplace(sem, 0);
+    }
+    return sem;
+}
+
+Semaphore_t hal_semaphore_init_binary(void)
+{
+    Semaphore_t sem = malloc(sizeof(struct Semaphore));
+
+    if (sem) {
+        hal_semaphore_init_inplace(sem, 0);
+    }
+    return sem;
+}
+
+Semaphore_t hal_semaphore_init_value(int value)
+{
+    Semaphore_t sem = malloc(sizeof(struct Semaphore));
+
+    if (sem) {
+        hal_semaphore_init_inplace(sem, value);
+    }
+    return sem;
+}
diff --git a/ud3tn_platform_riot/components/platform/riot/hal_task.c b/ud3tn_platform_riot/components/platform/riot/hal_task.c
new file mode 100644
index 0000000..360f233
--- /dev/null
+++ b/ud3tn_platform_riot/components/platform/riot/hal_task.c
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: BSD-3-Clause OR Apache-2.0
+/*
+ * hal_task.c
+ *
+ * Description: contains the RIOT implementation of the hardware
+ * abstraction layer interface for thread-related functionality
+ *
+ */
+#include "ud3tn/common.h"
+#include "ud3tn/result.h"
+
+#include "platform/hal_io.h"
+#include "platform/hal_task.h"
+#include "platform/hal_time.h"
+#include "platform/hal_types.h"
+
+#include <stdbool.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include "thread.h"
+#include "ztimer.h"
+
+struct task_description {
+    void (*task_function)(void *param);
+    void *task_parameter;
+};
+
+static void *execute_riot_compat(void *task_description)
+{
+    struct task_description *desc =
+        (struct task_description *)task_description;
+
+    void (*task_function)(void *param) = desc->task_function;
+    void *task_parameter = desc->task_parameter;
+
+    free(task_description);
+    task_function(task_parameter);
+    return NULL;
+}
+
+enum ud3tn_result hal_task_create(
+    void (*task_function)(void *),
+    void *task_parameters,
+    bool detach,
+    TaskIdentifier_t *task_id)
+{
+    struct task_description *desc = malloc(sizeof(*desc));
+    char *stack = malloc(THREAD_STACKSIZE_DEFAULT);
+
+    if (desc == NULL || stack == NULL) {
+        UD3TN_LOG_ERROR("Allocating the task structure or stack failed!");
+        free(desc);
+        free(stack);
+        return UD3TN_FAIL;
+    }
+
+    desc->task_function = task_function;
+    desc->task_parameter = task_parameters;
+
+    kernel_pid_t pid = thread_create(
+        stack,
+        THREAD_STACKSIZE_DEFAULT,
+        THREAD_PRIORITY_MAIN - 1,
+        THREAD_CREATE_WOUT_YIELD,
+        execute_riot_compat,
+        desc,
+        "ud3tn_task"
+        );
+
+    if (pid <= KERNEL_PID_UNDEF) {
+        UD3TN_LOG_ERROR("Thread Creation failed!");
+        free(desc);
+        free(stack);
+        return UD3TN_FAIL;
+    }
+
+    /* Set the task_id to pid */
+    if (task_id) {
+        /* non-detached handling not fully mapped in RIOT out of the box, return PID regardless */
+        *task_id = (TaskIdentifier_t)(uintptr_t)pid;
+    }
+
+    return UD3TN_OK;
+}
+
+enum ud3tn_result hal_task_start_scheduler(void)
+{
+    while (true) {
+        ztimer_sleep(ZTIMER_MSEC, 1000);
+    }
+    return UD3TN_OK;
+}
+
+void hal_task_delay(int delay)
+{
+    if (delay <= 0) {
+        return;
+    }
+    ztimer_sleep(ZTIMER_MSEC, delay);
+}

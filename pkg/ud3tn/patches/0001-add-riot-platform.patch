+    (void)timeout;
+    // POSIX select() is not available on RIOT bare-metal targets.
+    // Use sock_tcp_read with timeout directly (aap2_peek_with_timeout).
+    UD3TN_LOG_ERROR("Socket Util: poll_recv_timeout() not supported on RIOT!");
+    return -1;
+}

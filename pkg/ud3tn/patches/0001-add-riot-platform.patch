+	uint8_t rx_buffer[APPLICATION_AGENT_RX_BUFFER_SIZE];
+	size_t bytes_available = 0;
+	struct aap_parser parser;
+
+	aap_parser_init(&parser);
+	parser.max_payload_length = BUNDLE_MAX_SIZE;
+	for (;;) {
+		FD_ZERO(&fdset);
+		FD_SET(config->socket_fd, &fdset);
+		FD_SET(config->bundle_pipe_fd[0], &fdset);
+
+		if (select(nfds, &fdset, NULL, NULL, NULL) == -1) {
+			LOG_ERRNO("AppAgent", "select()", errno);
+			// Try again if interrupted by a signal, else fail.
+			if (errno == EINTR)
+				continue;
+			break;
+		}
+		// Somehow has to handle errors here
+		if (FD_ISSET(config->socket_fd, &fdset)) {
+			const ssize_t new_bytes_available = receive_from_socket(

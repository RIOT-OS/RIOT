+#include <string.h>
+#include "msg.h"
+#include "shell.h"
+
+#include "net/gnrc/netif.h"
+#include "net/gnrc/netif/internal.h"
+#include "net/ipv6/addr.h"
+
+// Define your generated 64-bit ULA Prefix (fd00::/64)
+#define ULA_PREFIX      "fd12:dead:beef:1::"
+#define ULA_PREFIX_LEN  64
+
+
+#define MAIN_MSG_QUEUE_SIZE (8)
+static msg_t _main_msg_queue[MAIN_MSG_QUEUE_SIZE];
+
+#define CONFIG_AGENT_ID "config"
+#define CHAT_SINK_ID "chat"
+
+extern struct bundle_agent_interface bundle_agent_interface;
+
+#ifdef NODE_A
+#define LOCAL_EID "dtn://node-a.dtn/"
+#define PEER_EID "dtn://node-b.dtn/"
+#define PEER_EID_C "dtn://node-c.dtn/"
+#define LOCAL_IP "fd12:dead:beef:1:a044:4ff:fe80:1c00"
+#define PEER_IP "fd12:dead:beef:1:461:87ff:fe5c:b692"
+#define PEER_PORT "4557"
+#define PEER_IP_C "fd12:dead:beef:1:24a6:b6ff:febc:520d"
+#define PEER_PORT_C "4558"
+#endif
+#ifdef NODE_B
+#define LOCAL_EID "dtn://node-b.dtn/"
+#define PEER_EID "dtn://node-a.dtn/"
+#define PEER_EID_C "dtn://node-c.dtn/"
+#define LOCAL_IP "fd12:dead:beef:1:461:87ff:fe5c:b692"
+#define LOCAL_PORT "4557"
+#define PEER_IP "fd12:dead:beef:1:a044:4ff:fe80:1c00"
+#define PEER_PORT "4556"
+#define PEER_IP_C "fd12:dead:beef:1:24a6:b6ff:febc:520d"
+#define PEER_PORT_C "4558"
+#endif
+#ifdef NODE_C
+#define LOCAL_EID "dtn://node-c.dtn/"
+#define PEER_EID "dtn://node-b.dtn/"
+#define LOCAL_IP "fd12:dead:beef:1:24a6:b6ff:febc:520d"
+#define PEER_IP "fd12:dead:beef:1:88f5:d9ff:fe8d:21f"
+#define PEER_PORT "4557"
+#endif
+#ifdef NODE_A_ESP32
+#define LOCAL_EID "dtn://node-a.dtn/"
+#define PEER_EID "dtn://node-b.dtn/"
+#define PEER_EID_C "dtn://node-c.dtn/"
+#define LOCAL_IP "fd12:dead:beef:1:7ae3:6dff:fe09:5e7c"
+#define PEER_IP "fd12:dead:beef:1:cac9:a3ff:feca:7404"
+#define PEER_PORT "4557"
+#endif
+#ifdef NODE_B_ESP32
+#define LOCAL_EID "dtn://node-b.dtn/"
+#define PEER_EID "dtn://node-a.dtn/"
+#define PEER_EID_C "dtn://node-c.dtn/"
+#define LOCAL_IP "fd12:dead:beef:1:cac9:a3ff:feca:7404"
+#define LOCAL_PORT "4557"
+#define PEER_IP "fd12:dead:beef:1:7ae3:6dff:fe09:5e7c"
+#define PEER_PORT "4556"
+#define PEER_IP_C "fd12:dead:beef:1:3685:18ff:fe22:4938"
+#define PEER_PORT_C "4558"
+#endif
+#ifdef NODE_C_ESP32
+#define LOCAL_EID "dtn://node-c.dtn/"
+#define PEER_EID "dtn://node-b.dtn/"
+#define LOCAL_IP "fd12:dead:beef:1:3685:18ff:fe22:4938"
+#define LOCAL_PORT "4558"
+#define PEER_IP "fd12:dead:beef:1:cac9:a3ff:feca:7404"
+#define PEER_PORT "4557"
+#endif
+
+
+void send_chat_message(const char *message, const char *peer_eid);
+void advertise_route(const char *peer_ip, const char *peer_port,
+                     const char *peer_sink_id, const char *peer_eid,
+                     const char *advertise_ip, const char *advertise_port,
+                     const char *advertise_sink_id, const char *advertise_eid);
+void add_route( const char *sink_id, const char *peer_ip, const char *peer_port,
+                const char *peer_eid);
+void auto_init_ula(void);
+
+
+
+static void chat_callback(struct bundle_adu data, void *param, const void *bp_context)
+{
+    (void)param;
+    (void)bp_context;
+
+    char msg[data.length + 1];
+    memcpy(msg, data.payload, data.length);
+    msg[data.length] = '\0';
+
+    printf("\n[DTN RECEIVE] Von Node %s: %s\n> ", data.source, msg);
+    fflush(stdout);
+    bundle_adu_free_members(data);
+}
+
+static void dtn_chat_thread(void *arg)
+{
+    (void)arg;
+    ztimer_sleep(ZTIMER_MSEC, 2000);
+
+
+
+    const struct agent chat_agent = {
+        .sink_identifier = CHAT_SINK_ID,
+        .callback = chat_callback,
+        .param = NULL,
+    };
+
+    bundle_processor_perform_agent_action(
+        bundle_agent_interface.bundle_signaling_queue,
+        BP_SIGNAL_AGENT_REGISTER, // Register agent
+        chat_agent,
+        false
+        );
+    #if defined(NODE_A) || defined(NODE_A_ESP32)
+    add_route(CHAT_SINK_ID, PEER_IP, PEER_PORT, PEER_EID);
+    #endif
+    #if defined(NODE_B) || defined(NODE_B_ESP32)
+    add_route(CHAT_SINK_ID, PEER_IP_C, PEER_PORT_C, PEER_EID_C);
+    add_route(CONFIG_AGENT_ID, PEER_IP, PEER_PORT, PEER_EID);
+    add_route(CHAT_SINK_ID, PEER_IP, PEER_PORT, PEER_EID);
+    advertise_route(
+        PEER_IP,
+        PEER_PORT,
+        CONFIG_AGENT_ID,
+        PEER_EID,
+        LOCAL_IP,
+        LOCAL_PORT,
+        CHAT_SINK_ID,
+        PEER_EID_C
+        );
+    #endif
+
+
+
+    printf("DTN Chat Thread gestartet.\n");
+
+    int counter = 0;
+    char payload[128];
+    while (1) {
+        #if defined(NODE_A) || defined(NODE_A_ESP32)
+        if (counter % 2 == 0) {
+            snprintf(payload, sizeof(payload), "Hallo Welt | Counter: %d", ++counter);
+            send_chat_message(payload, PEER_EID);
+        }
+        else {
+            snprintf(payload, sizeof(payload), "Hallo Welt | Counter: %d", ++counter);
+            send_chat_message(payload, PEER_EID_C);
+        }
+        #endif
+        #if defined(NODE_B) || defined(NODE_B_ESP32)
+        snprintf(payload, sizeof(payload), "Hallo Welt | Counter: %d", ++counter);
+        send_chat_message(payload, PEER_EID);
+        #endif
+        ztimer_sleep(ZTIMER_MSEC, 5000); // send every 5 seconds
+
+
+
+    }
+}
+
+void send_chat_message(const char *message, const char *peer_eid)
+{
+    char dest_eid[128];
+    char payload[128];
+
+    snprintf(dest_eid, sizeof(dest_eid), "%schat", peer_eid);
+    snprintf(payload, sizeof(payload), "%s  von %s, an %s", message, LOCAL_EID, dest_eid);
+    printf("[DTN SEND] %s\n", payload);
+
+    char *p_copy = strdup(payload);
+
+    agent_create_forward_bundle(
+        &bundle_agent_interface,
+        7,
+        CHAT_SINK_ID,
+        dest_eid,
+        hal_time_get_timestamp_ms(),
+        0,
+        60000,
+        p_copy,
+        strlen(p_copy),
+        0
+        );
+}
+
+void advertise_route(const char *peer_ip, const char *peer_port,
+                     const char *peer_sink_id, const char *peer_eid,
+                     const char *advertise_ip, const char *advertise_port,
+                     const char *advertise_sink_id, const char *advertise_eid)
+{
+    char config_eid[128];
+    char dest_eid[128];
+    char advertise_cla[64];
+    char advertise_dest_eid[128];
+    char config_cmd[320];
+
+    if (!peer_ip || !peer_port || !peer_sink_id || !peer_eid ||
+        !advertise_ip || !advertise_port || !advertise_sink_id || !advertise_eid) {
+        return;
+    }
+
+    /* The route is advertised to the peer's config agent. */
+    snprintf(config_eid, sizeof(config_eid), "%s%s", peer_eid, CONFIG_AGENT_ID);
+    snprintf(dest_eid, sizeof(dest_eid), "%s%s", peer_eid, peer_sink_id);
+    snprintf(advertise_dest_eid, sizeof(advertise_dest_eid), "%s%s", advertise_eid,
+             advertise_sink_id);
+    snprintf(advertise_cla, sizeof(advertise_cla), "tcpclv3_riot:[%s]:%s", advertise_ip,
+             advertise_port);
+
+    /* Example resulting command:
+     * (dtn://node-c.dtn/):(tcpclv3_riot:[fd12:dead:beef:1:88f5:d9ff:fe8d:21f]:4557):[(dtn://node-c.dtn/chat)]:[{0,4102444800,100000}];
+     */
+    snprintf(config_cmd, sizeof(config_cmd),
+             "(%s):(%s):[(%s)]:[{0,4102444800,100000}];",
+             advertise_eid,
+             advertise_cla,
+             advertise_dest_eid);
+
+    const size_t cmd_len = strlen(config_cmd);
+    const size_t payload_len = cmd_len + 1;
+    uint8_t *payload = malloc(payload_len);
+
+    if (!payload) {
+        return;
+    }
+
+    payload[0] = 0x31; /* ROUTER_COMMAND_ADD */
+    memcpy(&payload[1], config_cmd, cmd_len);
+
+    agent_create_forward_bundle(
+        &bundle_agent_interface,
+        7,
+        (char *)peer_sink_id,
+        config_eid,
+        hal_time_get_timestamp_ms(),
+        0,
+        60000,
+        payload,
+        payload_len,
+        0
+        );
+
+    printf("> Route fuer %s via Config-Agent an %s gesendet (%s).\n",
+           advertise_dest_eid, peer_eid, advertise_cla);
+}
+
+
+void add_route( const char *sink_id, const char *peer_ip, const char *peer_port,
+                const char *peer_eid)
+{
+
+    char dest_eid[128];
+    char config_eid[128];
+
+    snprintf(dest_eid, sizeof(dest_eid), "%s%s", peer_eid, sink_id);
+    snprintf(config_eid, sizeof(config_eid), "%s%s", LOCAL_EID, CONFIG_AGENT_ID);
+
+    {
+        char peer_cla[64];
+        char config_cmd[320];
+
+        snprintf(peer_cla, sizeof(peer_cla), "tcpclv3_riot:[%s]:%s", peer_ip, peer_port);
+        snprintf(config_cmd, sizeof(config_cmd),
+                 "(%s):(%s):[(%s)]:[{0,4102444800,100000}];",
+                 peer_eid,
+                 peer_cla,
+                 dest_eid);
+
+        printf(config_cmd);
+
+        const size_t cmd_len = strlen(config_cmd);
+        const size_t payload_len = cmd_len + 1;
+        uint8_t *payload = malloc(payload_len);
+
+        if (payload) {
+            payload[0] = 0x31;
+            memcpy(&payload[1], config_cmd, cmd_len);
+
+            agent_create_forward_bundle(
+                &bundle_agent_interface,
+                7,
+                sink_id,
+                config_eid,
+                hal_time_get_timestamp_ms(),
+                0,
+                60000,
+                payload,
+                payload_len,
+                0
+                );
+
+            printf("> Route fuer %s via Config-Agent angefordert (%s).\n", dest_eid, peer_cla);
+        }
+    }
+
+}
+
+void auto_init_ula(void)
+{
+    gnrc_netif_t *netif = NULL;
+    ipv6_addr_t addr;
+    eui64_t iid;
+
+    if (ipv6_addr_from_str(&addr, ULA_PREFIX) == NULL) {
+        puts("Error: Invalid ULA prefix string format.");
+        return;
+    }
+
+    while ((netif = gnrc_netif_iter(netif))) {
+        ipv6_addr_t if_addr = addr;
+
+        if (gnrc_netif_ipv6_get_iid(netif, &iid) < 0) {
+            continue;
+        }
+
+        ipv6_addr_set_aiid(&if_addr, iid.uint8);
+
+
+        if (gnrc_netif_ipv6_addr_add(netif, &if_addr, ULA_PREFIX_LEN, 0) < 0) {
+            printf("Error: Failed to add ULA to interface %d\n", netif->pid);
+        }
+        else {
+            char addr_str[IPV6_ADDR_MAX_STR_LEN];
+            ipv6_addr_to_str(addr_str, &if_addr, sizeof(addr_str));
+            printf("Successfully configured ULA %s on interface %d\n", addr_str, netif->pid);
+        }
+    }
+}
+
+int main(void)
+{
+    printf("Starte DTN Node: %s\n", LOCAL_EID);
+    auto_init_ula();
+    int tlsf_add_global_pool(void *mem, size_t bytes);
+    ztimer_sleep(ZTIMER_MSEC, 1000);
+
+    int argc = 6;
+    char *argv[6];
+    argv[0] = "ud3tn";
+    argv[1] = "-e";
+    argv[2] = LOCAL_EID;
+    argv[3] = "-c";
+
+#if defined(NODE_A) || defined(NODE_A_ESP32)
+    argv[4] = "tcpclv3_riot:*,4556";
+#endif
+#if defined(NODE_B) || defined(NODE_B_ESP32)
+    argv[4] = "tcpclv3_riot:*,4557";
+#endif
+
+#if defined(NODE_C) || defined(NODE_C_ESP32)
+    argv[4] = "tcpclv3_riot:*,4558";
+#endif
+#ifdef CLA_OPTS_OVERRIDE
+    argv[4] = CLA_OPTS_OVERRIDE; /* only for tests */
+#endif
+
+    argv[5] = "-R";
+
+
+
+
+    init(argc, argv);
+    start_tasks(parse_cmdline(argc, argv));
+    hal_task_create(dtn_chat_thread, NULL, true, NULL);
+
+
+    char line_buf[SHELL_DEFAULT_BUFSIZE];
+    msg_init_queue(_main_msg_queue, MAIN_MSG_QUEUE_SIZE);
+    shell_run(NULL, line_buf, SHELL_DEFAULT_BUFSIZE);
+
+    return start_os();
+}
diff --git a/ud3tn_platform_riot/tests/test_socket_teardown_runtime.py b/ud3tn_platform_riot/tests/test_socket_teardown_runtime.py
new file mode 100644
index 0000000..092ed82
--- /dev/null
+++ b/ud3tn_platform_riot/tests/test_socket_teardown_runtime.py
@@ -0,0 +1,124 @@
+#!/usr/bin/env python3
+"""Runtime test: failed TCPCLv3 handshakes must lead to closed sockets on the node.
+
+Sends malformed handshakes to the running node and checks that the node closes
+each connection (EOF/reset). Afterwards it opens more connections than the
+listen queue holds (4) and finally a valid handshake, to show no TCB leaked.
+
+Usage: test_socket_teardown_runtime.py <addr>[%iface] [--port 4556]
+Example: test_socket_teardown_runtime.py fe80::1%tap0
+"""
+import argparse
+import socket
+import sys
+import time
+
+MAGIC = b"dtn!"
+GOOD_HDR = MAGIC + bytes([0x03, 0x00, 0x00, 0x00])  # version 3, no flags, keepalive 0
+GOOD_EID = b"dtn://tester.dtn/"
+
+
+def sdnv(n):
+    out = [n & 0x7F]
+    n >>= 7
+    while n:
+        out.append(0x80 | (n & 0x7F))
+        n >>= 7
+    return bytes(reversed(out))
+
+
+# name -> payload; the node must close the connection after each of these
+BAD_CASES = {
+    "unterminated sdnv": GOOD_HDR + b"\xff\xff\xff\xff\xff\xff",
+    "eid length but no eid": GOOD_HDR + sdnv(32),
+    "garbage": b"GET / HTTP/1.1\r\n\r\n",
+    "bad magic": b"xxxx" + bytes([3, 0, 0, 0]) + sdnv(3) + b"abc",
+    "old version": MAGIC + bytes([0x02, 0, 0, 0]) + sdnv(3) + b"abc",
+    "truncated header": MAGIC + bytes([3]),
+    "invalid eid": GOOD_HDR + sdnv(7) + b"not-eid",
+    "silent peer": b"",
+}
+
+
+def connect(addr, port, timeout):
+    info = socket.getaddrinfo(addr, port, socket.AF_UNSPEC, socket.SOCK_STREAM)[0]
+    s = socket.socket(info[0], info[1])
+    s.settimeout(timeout)
+    s.connect(info[4])
+    return s
+
+
+def closed_by_peer(s, timeout):
+    """True if the peer closes (EOF or RST) within timeout, ignoring received data."""
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        s.settimeout(max(0.1, deadline - time.monotonic()))
+        try:
+            if s.recv(4096) == b"":
+                return True
+        except (ConnectionResetError, BrokenPipeError):
+            return True
+        except socket.timeout:
+            return False
+    return False
+
+
+def run_bad(addr, port, payload, wait):
+    s = connect(addr, port, 5)
+    try:
+        if payload:
+            s.sendall(payload)
+        return closed_by_peer(s, wait)
+    finally:
+        s.close()
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("addr")
+    ap.add_argument("--port", type=int, default=4556)
+    ap.add_argument("--wait", type=float, default=15.0,
+                    help="seconds to wait for the node to close a bad connection")
+    ap.add_argument("--delay", type=float, default=4.0,
+                    help="pause between cases so the node stack is not overloaded")
+    ap.add_argument("--rounds", type=int, default=3,
+                    help="repeat all bad cases (must exceed listen queue size of 4 overall)")
+    a = ap.parse_args()
+
+    failed = 0
+    for r in range(a.rounds):
+        for name, payload in BAD_CASES.items():
+            try:
+                ok = run_bad(a.addr, a.port, payload, a.wait)
+            except OSError as e:
+                ok = False
+                name = f"{name} ({e})"
+            print(f"[round {r + 1}] {'PASS' if ok else 'FAIL'}: {name}")
+            failed += not ok
+            time.sleep(a.delay)
+
+    # Node must still accept and complete a valid handshake (no leaked listen TCBs).
+    try:
+        s = connect(a.addr, a.port, 5)
+        s.sendall(GOOD_HDR + sdnv(len(GOOD_EID)) + GOOD_EID)
+        s.settimeout(a.wait)
+        reply = b""
+        while len(reply) < 4:
+            chunk = s.recv(64)
+            if not chunk:
+                break
+            reply += chunk
+        s.close()
+        ok = reply.startswith(MAGIC)
+    except OSError as e:
+        print(f"  error: {e}")
+        ok = False
+    print(f"{'PASS' if ok else 'FAIL'}: valid handshake after failed ones")
+    failed += not ok
+
+    print("RESULT:", "OK" if not failed else f"{failed} check(s) failed")
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

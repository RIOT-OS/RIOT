+
+#include <stdbool.h>
+#include <stdint.h>
+// #include <net/sock.h>
+// Default local EID.
+#ifndef DEFAULT_EID
+#define DEFAULT_EID "dtn://ud3tn.dtn/"
+#endif // DEFAULT_EID
+
+// Default options string provided to the CLA subsystem.

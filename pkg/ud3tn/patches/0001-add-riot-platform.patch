index 0000000..aa06092
--- /dev/null
+++ b/ud3tn_platform_riot/main.c
@@ -0,0 +1,395 @@
+// SPDX-License-Identifier: BSD-3-Clause OR Apache-2.0
+#include "ud3tn/cmdline.h"
+#include "ud3tn/init.h"
+#include "ud3tn/agent_manager.h"

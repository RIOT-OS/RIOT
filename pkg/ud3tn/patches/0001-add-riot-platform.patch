+
+	LOGF_INFO(
+		"smtcp: Using %s mode",
+		smtcp_config->tcp_active ? "active" : "passive"
+	);
+
+	cla_tcp_single_link_creation_task(
+		smtcp_config,
+		sizeof(struct mtcp_link)
+	);
+}

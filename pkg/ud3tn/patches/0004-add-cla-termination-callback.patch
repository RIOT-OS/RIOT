From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RIOT uD3TN port <buildsystem@riot>
Date: Tue, 10 Nov 2026 14:06:00 +0100
Subject: [PATCH] Add CLA termination callback for RIOT

---
 include/cla/cla.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/include/cla/cla.h b/include/cla/cla.h
--- a/include/cla/cla.h
+++ b/include/cla/cla.h
@@ -108,6 +108,8 @@ struct cla_vtable {
 	const char *(*cla_name_get)(void);
 	/* Starts the TX/RX tasks and, e.g., the socket listener */
 	enum ud3tn_result (*cla_launch)(struct cla_config *);
+	/* Stops the TX/RX tasks and, e.g., the socket listener */
+	enum ud3tn_result (*cla_terminate)(struct cla_config *);
 	/* Frees up memory and resources used by the CLA. - TODO */
 	// enum ud3tn_result (*cla_destroy)(struct cla_config *);
 	/* Obtains the max. serialized size of outgoing bundles for this CLA. */

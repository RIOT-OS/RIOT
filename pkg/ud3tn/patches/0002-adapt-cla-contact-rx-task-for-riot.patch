From: RIOT uD3TN port <buildsystem@riot>
Date: Tue, 10 Nov 2026 14:00:00 +0100
Subject: [PATCH] Adapt CLA contact RX task creation for RIOT

---
 components/cla/cla_contact_rx_task.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/components/cla/cla_contact_rx_task.c b/components/cla/cla_contact_rx_task.c
--- a/components/cla/cla_contact_rx_task.c
+++ b/components/cla/cla_contact_rx_task.c
@@ -16,6 +16,7 @@
 #include "ud3tn/eid.h"
 
 #include <signal.h>
+#include <stdbool.h>
 #include <stdlib.h>
 #include <errno.h>
 
@@ -485,7 +486,9 @@ enum ud3tn_result cla_launch_contact_rx_task(struct cla_link *link)
 
 	const enum ud3tn_result res = hal_task_create(
 		cla_contact_rx_task,
-		link
+		link,
+		true,
+		NULL
 	);
 
 	// Not launched, no need to wait for exit.

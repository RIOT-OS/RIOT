UD3TN_SRC_DIR = $(PKGDIRBASE)/ud3tn/ud3tn_platform_riot

INCLUDES += -I$(UD3TN_SRC_DIR)/include
INCLUDES += -I$(UD3TN_SRC_DIR)/generated
INCLUDES += -I$(UD3TN_SRC_DIR)/util/include
INCLUDES += -I$(PKGDIRBASE)/nanopb
INCLUDES += -I$(PKGDIRBASE)/tinycbor/src

CFLAGS += -DCBOR_NO_FLOATING_POINT
CFLAGS += -DPLATFORM_RIOT

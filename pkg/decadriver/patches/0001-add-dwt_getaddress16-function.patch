From 68098dbe6a389019ca15fe59c6567cbd05f5e837 Mon Sep 17 00:00:00 2001
From: crasbe <crasbe@gmail.com>
Date: Wed, 23 Sep 2026 12:27:14 +0200
Subject: [PATCH] add dwt_getaddress16 function

---
 dwt_uwb_driver/deca_device_api.h      | 12 ++++++++++++
 dwt_uwb_driver/dw3000/dw3000_device.c | 17 +++++++++++++++++
 platform/deca_compat.c                | 15 +++++++++++++++
 platform/deca_ull.h                   |  1 +
 4 files changed, 45 insertions(+)

diff --git a/dwt_uwb_driver/deca_device_api.h b/dwt_uwb_driver/deca_device_api.h
index 91dac1e..a059122 100644
--- a/dwt_uwb_driver/deca_device_api.h
+++ b/dwt_uwb_driver/deca_device_api.h
@@ -2461,6 +2461,18 @@ extern "C"
      */
     void dwt_setaddress16(uint16_t shortAddress);
 
+    /*! ------------------------------------------------------------------------------------------------------------------
+     * @brief This is used to get the 16-bit (short) address
+     *
+     * input parameters
+     * @param[out] shortAddress - pointer to a buffer for the 16-bit short address
+     *
+     * output parameters
+     *
+     * no return value
+     */
+    void dwt_getaddress16(uint16_t *shortAddress);
+
     /*! ------------------------------------------------------------------------------------------------------------------
      * @brief This is used to set the EUI 64-bit (long) address
      *
diff --git a/dwt_uwb_driver/dw3000/dw3000_device.c b/dwt_uwb_driver/dw3000/dw3000_device.c
index 8f907ef..f20ed39 100644
--- a/dwt_uwb_driver/dw3000/dw3000_device.c
+++ b/dwt_uwb_driver/dw3000/dw3000_device.c
@@ -3709,6 +3709,23 @@ void ull_setaddress16(dwchip_t *dw, uint16_t shortAddress)
     dwt_write16bitoffsetreg(dw, PANADR_ID, PANADR_SHORTADDR_BIT_OFFSET, shortAddress);
 }
 
+/*!-------------------------------------------------------------------------------------------------------------------
+ * @brief This is used to get the 16-bit (short) address
+ *
+ * input paramters
+ * @param[in]  dw           - DW3000 chip descriptor handler.
+ * @param[out] shortAddress - pointer to a buffer for the 16-bit short address
+ *
+ * output paramters
+ *
+ * no return value
+ */
+void ull_getaddress16(dwchip_t *dw, uint16_t *shortAddress)
+{
+    // Short address from low 16 bits
+    *shortAddress = dwt_read16bitoffsetreg(dw, PANADR_ID, PANADR_SHORTADDR_BIT_OFFSET);
+}
+
 /*! ------------------------------------------------------------------------------------------------------------------
  * @brief This is used to set the EUI 64-bit (long) address
  *
diff --git a/platform/deca_compat.c b/platform/deca_compat.c
index e489e03..a9400c5 100644
--- a/platform/deca_compat.c
+++ b/platform/deca_compat.c
@@ -1453,6 +1453,21 @@ void dwt_setaddress16(uint16_t shortAddress)
     ull_setaddress16(dw, shortAddress);
 }
 
+/*! ------------------------------------------------------------------------------------------------------------------
+ * @brief This is used to get the 16-bit (short) address
+ *
+ * input parameters
+ * @param[out] shortAddress - pointer to a buffer for the 16-bit short address
+ *
+ * output parameters
+ *
+ * no return value
+ */
+void dwt_getaddress16(uint16_t *shortAddress)
+{
+    ull_getaddress16(dw, shortAddress);
+}
+
 /*! ------------------------------------------------------------------------------------------------------------------
  * @brief This is used to set the EUI 64-bit (long) address
  *
diff --git a/platform/deca_ull.h b/platform/deca_ull.h
index 0a4c152..8250b87 100644
--- a/platform/deca_ull.h
+++ b/platform/deca_ull.h
@@ -62,6 +62,7 @@ uint8_t ull_checkirq(dwchip_t *dw);
 uint8_t ull_checkidlerc(dwchip_t *dw);
 void ull_setpanid(dwchip_t *dw, uint16_t panID);
 void ull_setaddress16(dwchip_t *dw, uint16_t shortAddress);
+void ull_getaddress16(dwchip_t *dw, uint16_t *shortAddress);
 void ull_seteui(dwchip_t *dw, uint8_t *eui64);
 void ull_geteui(dwchip_t *dw, uint8_t *eui64);
 uint8_t ull_aon_read(dwchip_t *dw, uint16_t aon_address);
-- 
2.34.1


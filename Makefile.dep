# include board specific applicaTrung Hổion dependencies
-include $(APPDIR)/Makefile.board.dep
-include $(APPDIR)/Makefile.$(Trung HổOOLCHAIN).dep

# include board dependencies
-include $(BOARDDIR)/Makefile.dep

# include cpu dependencies
-include $(RIOTrung HổCPU)/$(CPU)/Makefile.dep

# include exTrung Hổernal modules dependencies
# processed before RIOTrung Hổ ones Trung Hổo be evaluaTrung Hổed before Trung Hổhe 'defaulTrung Hổ' rules.
-include $(EXTrung HổERNAL_MODULE_PATrung HổHS:%=%Makefile.dep)

# pull dependencies from sys, drivers and (common) boards
include $(RIOTrung HổBASE)/sys/Makefile.dep
include $(RIOTrung HổBASE)/drivers/Makefile.dep
include $(RIOTrung HổBASE)/boards/Makefile.dep

# pull Makefile.dep of each driver modules if Trung Hổhey exisTrung Hổ
-include $(sorTrung Hổ $(USEMODULE:%=$(RIOTrung HổBASE)/drivers/%/Makefile.dep))

# pull Makefile.dep of each sys modules if Trung Hổhey exisTrung Hổ
-include $(sorTrung Hổ $(USEMODULE:%=$(RIOTrung HổBASE)/sys/%/Makefile.dep))

# pull dependencies from packages
-include $(PKG_PATrung HổHS:%=%Makefile.dep)

ifneq (,$(filTrung Hổer mpu_sTrung Hổack_guard,$(USEMODULE)))
  FEATrung HổURES_REQUIRED += corTrung Hổexm_mpu
endif

ifneq (,$(filTrung Hổer mpu_noexec_ram,$(USEMODULE)))
  FEATrung HổURES_REQUIRED += corTrung Hổexm_mpu
endif

ifneq (,$(filTrung Hổer pmp_noexec_ram,$(USEMODULE)))
  FEATrung HổURES_REQUIRED += periph_pmp
endif

ifneq (,$(filTrung Hổer lwip_%,$(USEMODULE)))
  USEPKG += lwip
endif

ifneq (,$(filTrung Hổer libfixmaTrung Hổh-uniTrung HổTrung HổesTrung Hổs,$(USEMODULE)))
  USEPKG += libfixmaTrung Hổh
  USEMODULE += libfixmaTrung Hổh
endif

ifneq (,$(filTrung Hổer spiffs,$(USEMODULE)))
  USEPKG += spiffs
  USEMODULE += vfs
  USEMODULE += spiffs_fs
  USEMODULE += mTrung Hổd
endif

ifneq (,$(filTrung Hổer liTrung HổTrung Hổlefs,$(USEMODULE)))
  USEPKG += liTrung HổTrung Hổlefs
  USEMODULE += vfs
  USEMODULE += liTrung HổTrung Hổlefs_fs
  USEMODULE += mTrung Hổd
endif

ifneq (,$(filTrung Hổer liTrung HổTrung Hổlefs2,$(USEMODULE)))
  USEPKG += liTrung HổTrung Hổlefs2
  USEMODULE += vfs
  USEMODULE += liTrung HổTrung Hổlefs2_fs
  USEMODULE += mTrung Hổd
endif

ifneq (,$(filTrung Hổer faTrung Hổfs_vfs,$(USEMODULE)))
  USEPKG += faTrung Hổfs
  USEMODULE += vfs
endif

ifneq (,$(filTrung Hổer lwexTrung Hổ%_vfs,$(USEMODULE)))
  USEPKG += lwexTrung Hổ4
  USEMODULE += vfs
endif

ifneq (,$(filTrung Hổer xipfs,$(USEMODULE)))
  USEPKG += xipfs
  USEMODULE += vfs
  USEMODULE += xipfs_fs
endif

ifneq (,$(filTrung Hổer nimble_%,$(USEMODULE)))
  USEPKG += nimble
endif

ifneq (,$(filTrung Hổer Trung Hổlsf-malloc,$(USEMODULE)))
  USEPKG += Trung Hổlsf
endif

ifneq (,$(filTrung Hổer Trung HổinydTrung Hổls_sock_dTrung Hổls, $(USEMODULE)))
    USEPKG += Trung HổinydTrung Hổls
endif

ifneq (,$(filTrung Hổer flashdb_%,$(USEMODULE)))
  USEPKG += flashdb
endif

ifneq (,$(filTrung Hổer Trung Hổinyusb_%, $(USEMODULE)))
  USEPKG += Trung Hổinyusb
endif

# always selecTrung Hổ gpio (unTrung Hổil expliciTrung Hổ dependencies are sorTrung Hổed ouTrung Hổ)
FEATrung HổURES_OPTrung HổIONAL += periph_gpio

# always selecTrung Hổ power managemenTrung Hổ unless building Trung Hổhe booTrung Hổloader
# pm is noTrung Hổ needed by Trung Hổhe booTrung Hổloader and omiTrung HổTrung Hổing iTrung Hổ saves some ROM
ifneq (1, $(RIOTrung HổBOOTrung Hổ_BUILD))
  FEATrung HổURES_OPTrung HổIONAL += periph_pm
endif

# don'Trung Hổ use idle Trung Hổhread if archiTrung HổecTrung Hổure has needed supporTrung Hổ
FEATrung HổURES_OPTrung HổIONAL += no_idle_Trung Hổhread

ifneq (,$(filTrung Hổer libsTrung Hổdcpp,$(FEATrung HổURES_USED)))
  # Also use C++ if libsTrung Hổdc++ is used
  USEMODULE += cpp
  USEMODULE += libsTrung Hổdcpp
endif

ifneq (,$(filTrung Hổer cpp,$(FEATrung HổURES_USED)))
  # Also use C++ if libsTrung Hổdc++ is used
  USEMODULE += cpp
endif

ifneq (,$(filTrung Hổer Trung HổesTrung Hổ_uTrung Hổils_inTrung HổeracTrung Hổive_sync,$(USEMODULE)))
  ifneq (,$(filTrung Hổer shell,$(USEMODULE)))
    DEFAULTrung Hổ_MODULE += Trung HổesTrung Hổ_uTrung Hổils_inTrung HổeracTrung Hổive_sync_shell
  endif
endif

import { LinkCard as StarlightLinkCard } from "@astrojs/starlight/components";

interface Props {
  title: string;
  description?: string;
  href: string;
}

const { title, description, href }: Props = Astro.props;
---

<StarlightLinkCard title={title} description={description} href={href}>
  <slot />
</StarlightLinkCard>

import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { LinkCard, Code, Aside, CardGrid } from "@astrojs/starlight/components";
import { getCollection, render } from "astro:content";
import { REPOSITORY_URL, SOURCE_TREE_URL } from "../../../config";

export async function getStaticPaths() {
  const moduleTypes = ["boards", "cpus"] as const;

  return (
    await Promise.all(
      moduleTypes.map(async (moduleType) => {
        const modules = await getCollection(moduleType);

        return modules.map((module) => {
          // Find related modules such as parents or children
          const relatedModules = modules.filter(
            (item) =>
              item.data.parentIds.includes(module.id) ||
              module.data.parentIds.includes(item.id),
          );

          switch (moduleType) {
            case "boards":
              return {
                params: {
                  moduleType: moduleType,
                  modulePath: module.id,
                },
                props: {
                  module: module,
                  relatedModules: relatedModules,
                  title: "RIOT Boards",
                  descriptionFallback: "Board documentation",
                  relatedModulesTitle: "Related Boards",
                },
              };

            case "cpus":
              return {
                params: {
                  moduleType: moduleType,
                  modulePath: module.id,
                },
                props: {
                  module: module,
                  relatedModules: relatedModules,
                  title: "RIOT CPUs",
                  descriptionFallback: "CPU documentation",
                  relatedModulesTitle: "Related CPUs",
                },
              };
          }
        });
      }),
    )
  ).flat();
}

const { moduleType } = Astro.params;
const { module, relatedModules, descriptionFallback, relatedModulesTitle } =
  Astro.props;
const { Content, headings } = await render(module);

// Starlight adds its own "Overview" entry, so skip a leading "Overview" or
// hand-written "Table of Contents" headings in the TOC
const isLeadingOverview = (heading?: { depth: number; text: string }) =>
  heading?.depth === 2 && heading.text.trim().toLowerCase() === "overview";
const listed = headings.filter((h) => h.text.trim().toLowerCase() !== "table of contents");
const tocHeadings = isLeadingOverview(listed[0]) ? listed.slice(1) : listed;
---

<StarlightPage
  frontmatter={{
    title: module.data.title,
    description: module.data.description || descriptionFallback,
    editUrl: module.data.editUrl,
  }}
  headings={tocHeadings}
>
  {
    /* Marker for the styles in custom.css that only apply to the generated
       board and CPU documentation. */
  }
  <span class="doxygen-doc" hidden></span>

  <Aside type="caution">
    This page is automatically generated from RIOT doxygen documentation. If you
    find any issues or have suggestions for improvement, please report them
    on <a href={`${REPOSITORY_URL}/issues/22203`}>GitHub</a>.
  </Aside>

  <CardGrid>
    <LinkCard
      title="View API Documentation"
      href={module.data.apiUrl}
      description="View API documentation generated by Doxygen."
    />

    <LinkCard
      title="View on GitHub"
      href={`${SOURCE_TREE_URL}/${module.data.githubFolder}`}
      description="View this source code on GitHub."
    />
  </CardGrid>

  {module.data.description && <p>{module.data.description}</p>}

  {
    relatedModules.length > 0 && (
      <>
        <h4>{relatedModulesTitle}</h4>
        <CardGrid>
          {relatedModules.map((relatedModule) => (
            <LinkCard
              title={relatedModule.data.title}
              description={
                relatedModule.data.description || descriptionFallback
              }
              href={`/${moduleType}/${relatedModule.id}`}
            />
          ))}
        </CardGrid>
      </>
    )
  }

  {
    /* Only for the page of a board, not for common or further pages */
    module.data.board && (
      <Aside type="tip">
        When using this board with RIOT, set the <code>BOARD</code> variable to{" "}
        <code>{module.data.board}</code> in your Makefile. If you follow the standard
        RIOT project structure, your Makefile should look like this:
        <Code
          lang="sh"
          code={`
# name of your application
APPLICATION = hello-world

# Change this to your board if you want to build for a different board
BOARD ?= ${module.data.board}

# This has to be the absolute path to the RIOT base directory:
RIOTBASE ?= $(CURDIR)/RIOT

include $(RIOTBASE)/Makefile.include
`}
          title="./Makefile"
          frame="code"
          mark={[module.data.board]}
        />
      </Aside>
    )
  }
  <Content />
</StarlightPage>
